<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TowerForTwo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">@font/inter_variable</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="Theme.TowerForTwo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Use the foreground artwork directly instead of the adaptive launcher icon.
             This avoids the extra adaptive-icon scaling/masking that made the splash look soft. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_art</item>
        <item name="windowSplashScreenAnimationDuration">350</item>
        <item name="postSplashScreenTheme">@style/Theme.TowerForTwo</item>
    </style>
</resources>
